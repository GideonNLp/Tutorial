# Configuration of the production build. Copy this file to `.env.local` (not committed) or set the
# same names as environment variables in the build job. Every value is optional.
# Nothing here is secret: the values end up in the files served to the browser.

# Product name, shown in the interface, the web manifest and the generated files.
VITE_APP_NAME=CycleCare

# Address where the app is published, with the trailing slash. Used for the link on the 404 page
# and for the canonical link. The app itself uses relative addresses and works from any folder.
# VITE_PUBLIC_URL=https://example.com/

# Search engines: by default every page says "noindex" and robots.txt disallows everything.
# VITE_ALLOW_INDEXING=true

# Who offers the app (privacy statement, section 2). Unset fields stay visible as blanks to fill in.
# VITE_OPERATOR_NAME=
# VITE_OPERATOR_ADDRESS=
# VITE_OPERATOR_REGISTRATION=
# VITE_CONTACT_EMAIL=
# VITE_DPO_CONTACT=

# Set to "true" only after a lawyer has approved the consent and privacy texts:
# it removes the "draft" notice and the notes addressed to the reviewer.
# VITE_LEGAL_REVIEWED=true
